amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"

// oxfmt does not touch TOML: mise.toml is formatted by `mise fmt` (the "mise" step).
local linters = new Mapping<String, Step> {
  ["oxfmt"] = (Builtins.oxfmt) {
    exclude = List("**/pnpm-lock.yaml", "**/package-lock.json", "**/*.toml")
  }
  ["oxlint"] = Builtins.ox_lint
  // hexlet-check.yml нельзя править, поэтому jactionlint его не проверяет и не фиксит
  ["jactionlint"] = (Builtins.jactionlint) {
    exclude = List("**/hexlet-check.yml")
  }
  ["mise"] = Builtins.mise
}

hooks = new {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["pre-push"] {
    steps = linters
  }
  ["check"] {
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["commit-msg"] {
    steps = new {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }
}
